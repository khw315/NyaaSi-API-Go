                    {
                        "type": "string",
                        "example": "real",
                        "description": "Filter torrents by category (e.g., art, real).",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "videos",
                        "description": "Filter torrents by subcategory (e.g., anime, doujinshi, games, manga, pictures, photobooks, videos).",
                        "name": "sub_category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "downloads",
                        "description": "Sort torrents by attribute (comments, size, date, seeders, leechers, downloads).",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "desc",
                        "description": "Order in which torrents should be sorted (asc or desc).",
                        "name": "order",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number for pagination.",
                        "name": "page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/sukebei/id/{torrent_id}": {
            "get": {
                "description": "Fetch full details for a specific Sukebei torrent.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ID Search"
                ],
                "summary": "Sukebei Id Search",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 4505820,
                        "description": "The unique numeric ID of the torrent on sukebei.nyaa.si.",
                        "name": "torrent_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/sukebei/user/{user_name}": {
            "get": {
                "description": "Search for torrents uploaded by a specific user on sukebei.nyaa.si.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "User Search"
                ],
                "summary": "Sukebei User Search",
                "parameters": [
                    {
                        "type": "string",
                        "example": "offkab",
                        "description": "The Sukebei user name whose uploads you want to search.",
                        "name": "user_name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "The search query for torrents.",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter torrents by category.",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter torrents by subcategory.",
                        "name": "sub_category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort torrents by attribute.",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sorting order.",
                        "name": "order",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number.",
                        "name": "page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}